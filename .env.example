# ============================================
# Cloud Storage API - Variables de Entorno
# ============================================
# Copie este archivo como .env y configure los valores apropiados
# para su entorno antes de ejecutar docker-compose.
# ============================================

# --- Base de Datos PostgreSQL ---
# Contraseña para el usuario de la base de datos.
# Debe ser una contraseña segura en entornos de producción.
DB_PASSWORD=your_secure_database_password

# --- JSON Web Token (JWT) ---
# Clave secreta utilizada para firmar y verificar tokens JWT.
# Debe tener al menos 256 bits (32 caracteres) para el algoritmo HS256.
# Genere una clave segura, por ejemplo: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_at_least_256_bits

# --- Cifrado de Archivos (AES-256) ---
# Clave AES de 32 bytes codificada en Base64.
# Se utiliza para cifrar los archivos almacenados en el servidor.
# Genere una clave segura, por ejemplo: openssl rand -base64 32
ENCRYPTION_KEY=your_base64_encoded_32_byte_aes_key
