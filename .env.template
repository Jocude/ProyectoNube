# =========================================================================
#  Configuración del Servidor de Cloud Storage (B2B Self-Hosted)
# =========================================================================
#  Instrucciones: Renombra este archivo a `.env` y configura los valores
#  adecuados antes de ejecutar el script de instalación (deploy.bat/deploy.sh).
# =========================================================================

# -------------------------------------------------------------------------
#  1. Rutas de almacenamiento en el Servidor (Host)
# -------------------------------------------------------------------------
# Define la ruta absoluta o relativa del disco duro del servidor donde se guardarán los datos.
# Ejemplo en Windows: D:/NubeStorage/uploads
# Ejemplo en Linux: /mnt/storage/uploads
HOST_STORAGE_PATH=./uploads
HOST_DB_PATH=./pgdata

# -------------------------------------------------------------------------
#  2. Credenciales y Secretos de Seguridad
# -------------------------------------------------------------------------
# Contraseña de la base de datos PostgreSQL
DB_PASSWORD=securepassword123

# Secreto para la firma de JSON Web Tokens (autenticación de usuarios)
# Genera una clave segura de al menos 256 bits (32 caracteres alfanuméricos)
JWT_SECRET=defaultJwtSecretKeyThatShouldBeChangedInProduction2026!

# Clave maestra para el cifrado AES-256 de los archivos en disco
# DEBE ser una clave codificada en Base64 de exactamente 32 bytes (256 bits)
# Ejemplo de generación en bash: openssl rand -base64 32
ENCRYPTION_KEY=dGhpcyBpcyBhIDMyIGJ5dGUga2V5ISEhMTIzNDU2Nzg=

# -------------------------------------------------------------------------
#  3. Clave de Licencia del Cliente (Anti-Piratería)
# -------------------------------------------------------------------------
# Clave JWT firmada mediante RSA-256 suministrada por el proveedor.
# Si está vacía, no es válida o está expirada, el software detendrá su arranque.
APP_LICENSE_KEY=
